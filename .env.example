# Copy to .env (git-ignored) with:  npm run setup:env -- --google-client-id=<id> --admin-email=<you@gmail.com>
# Loaded automatically. Secrets live ONLY in .env locally or in your host's secret store (Render dashboard). Never commit them.

# --- AI (all language understanding goes through OpenRouter) ---
# Without a key the free offline rules agent answers. Choose Claude / ChatGPT / Gemini models in Admin > AI model.
OPENROUTER_API_KEY=

# --- Login with Google ---
# Public client id from Google Cloud Console (APIs & Services > Credentials > OAuth client, type "Web application").
# Authorized JavaScript origins: http://localhost:5173, http://localhost:3001 and your deployed URL. No client secret is needed.
GOOGLE_CLIENT_ID=
# Comma-separated Google account emails that become administrators (can use the no-code admin panel).
ADMIN_EMAILS=
# Signs login cookies. Generated for you by setup:env. Rotate to log everyone out.
SESSION_SECRET=
# Local testing without Google: set to true to enable a dev login box (ignored when NODE_ENV=production).
AUTH_DEV_LOGIN=false
# Sign-in attempts allowed per IP per minute.
AUTH_RATE_LIMIT_PER_MIN=20

# --- Database (PostgreSQL) ---
# Required in production. Local: `npm run db:up` starts PostgreSQL in Docker with these credentials.
# Tables are created and sample data is loaded automatically on first start (or run `npm run db:migrate`).
# Leave empty only for quick local experiments: the app then falls back to JSON files in DATA_DIR.
DATABASE_URL=postgres://healtrip:healtrip@localhost:5432/healtrip
# true = require TLS with certificate verification (managed databases reached over the internet, e.g. Neon/Supabase).
DATABASE_SSL=false

# --- Data & server ---
# JSON file store location, used only when DATABASE_URL is empty (development fallback).
DATA_DIR=
PORT=3001
CORS_ORIGIN=http://localhost:5173
EMERGENCY_NUMBER=997

# --- Optional legacy single-model modes (used only when OPENROUTER_API_KEY is empty) ---
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_FALLBACK=rules
LLM_MAX_TOKENS=600
LLM_TIMEOUT_MS=20000
